rules_version = '2';

// GeneMatch Firestore security rules — Phase 2 scope.
// Covers the `users` collection only, since case/sample/profile collections
// land in Phase 3 onward. Extend this file as those collections are added;
// do not rely on client-side nav hiding as the access boundary.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isStaff() {
      return currentRole() in [
        'super_admin', 'laboratory_admin', 'laboratory_technician',
        'case_manager', 'scientist_analyst', 'reviewer', 'auditor'
      ];
    }

    function isSuperAdmin() {
      return currentRole() == 'super_admin';
    }

    match /users/{userId} {
      // A user can read their own profile; staff can read any profile they
      // need for case assignment. Nobody can read arbitrary customer
      // profiles they aren't otherwise entitled to see.
      allow read: if isOwner(userId) || isStaff();

      // Self-registration always creates role "customer" — never a staff
      // role — and the role field can never be self-assigned to anything
      // else. Only a Super Admin can change someone's role after creation.
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'customer';

      allow update: if isOwner(userId)
                    && request.resource.data.role == resource.data.role
                    || isSuperAdmin();

      allow delete: if isSuperAdmin();
    }

    // -----------------------------------------------------------------
    // PHASE 3 — cases, samples, chain of custody
    // -----------------------------------------------------------------

    match /cases/{caseId} {
      // A customer can create their own case (request-test.html) and read
      // it back; they can never set its status, assignment, or any staff
      // field themselves. Staff can read and update any case.
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == 'submitted';

      allow read: if isSignedIn()
                  && (resource.data.createdBy == request.auth.uid || isStaff());

      allow update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    match /samples/{sampleId} {
      // Samples carry donor/participant identifiers and storage detail —
      // per spec section 6, don't expose more than necessary through a
      // sample record, so this stays staff-only rather than also granting
      // the owning customer direct read access.
      allow read, create, update: if isStaff();
      allow delete: if false; // samples are never deleted, only status-changed
    }

    match /custody_events/{eventId} {
      // Append-only: staff can log an event, nobody can edit or remove one
      // once written, per the immutability requirement in spec section 7.
      allow read, create: if isStaff();
      allow update, delete: if false;
    }

    match /genetic_profiles/{profileId} {
      // Genetic markers are the most sensitive data in the system — staff
      // only, same as samples, and never deleted (a failed import stays
      // visible with its FAIL status rather than disappearing, so there's
      // a record of what was attempted).
      allow read, create, update: if isStaff();
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isStaff();
      allow update, delete: if false;
    }

    match /counters/{counterId} {
      // Sequence counters for case/sample IDs. Any signed-in user needs
      // write access here because customers generate case IDs directly
      // from request-test.html. See the security note in case-data.js —
      // this is a deliberate MVP simplification, not a settled answer.
      allow read, write: if isSignedIn();
    }

    // Everything else is closed by default until its Phase lands with its
    // own explicit rule (genetic_profiles in Phase 5, reports in Phase 8, etc).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
